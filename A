<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>New Pong</title>
<style>*{box-sizing:border-box}body{margin:0;background:#0b1020;color:#eaf0ff;font-family:Arial,sans-serif;display:flex;justify-content:center;padding:20px}.wrap{width:min(900px,100%)}h1{text-align:center;letter-spacing:3px}h1 span{color:#fb7185}.stats{display:flex;justify-content:space-around;text-align:center;margin:18px 0}.stats strong{font-size:26px;display:block}.stats small{font-size:12px;color:#aab8d0}.field{position:relative;aspect-ratio:5/3;border:2px solid #35445e;border-radius:12px;overflow:hidden;touch-action:none;background:#090e1b}canvas{display:block;width:100%;height:100%}.overlay{position:absolute;inset:0;background:#090e1beF;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:15px;text-align:center}.overlay h2{font-size:clamp(23px,5vw,36px);margin:0}button{background:#2563eb;color:white;border:0;border-radius:9px;padding:12px 22px;font-weight:800;cursor:pointer}button:hover{background:#1d4ed8}.below{text-align:center;margin-top:16px}.hint{color:#9aaac4;font-size:13px;text-align:center}.reward{font-size:clamp(17px,4vw,27px);font-weight:900;color:#facc15;user-select:text}</style></head>
<body><main class="wrap"><h1>NEW <span>PONG</span></h1><div class="stats"><div><strong id="attempt">1</strong><small>ATTEMPT</small></div><div><strong id="score">0 / 10</strong><small>RETURNS</small></div><div><strong id="best">0</strong><small>BEST</small></div></div><div class="field" id="field"><canvas id="game" width="800" height="480"></canvas><div class="overlay" id="overlay"><h2 id="heading">CAN YOU BEAT IT?</h2><div class="reward" id="reward" hidden></div><button id="start">START GAME</button><small style="color:#91a3be">Press Enter to start or restart</small></div></div><div class="below"><button id="restart">Restart (Enter)</button></div><p class="hint">Move mouse, finger, or use ↑ ↓ to move your paddle.</p></main>
<script>
(()=>{const canvas=document.getElementById('game'),ctx=canvas.getContext('2d'),overlay=document.getElementById('overlay'),heading=document.getElementById('heading'),reward=document.getElementById('reward'),start=document.getElementById('start'),scoreEl=document.getElementById('score'),attemptEl=document.getElementById('attempt'),bestEl=document.getElementById('best');
const pattern=[.17,.79,.31,.91,.47,.09,.68,.38,.85,.54],incomingMs=480/.81,returningMs=320/.81;
let attempt=1,score=0,best=0,paddle=202,ballX=730,ballY=240,mode='idle',beginTime=0,last=performance.now(),trail=[],up=false,down=false,active=false,returnY=240,started=false;
function incoming(t){mode='incoming';beginTime=t;ballX=730;ballY=240;trail=[]}
function begin(){if(started&&active)attempt++;started=true;attemptEl.textContent=attempt;score=0;scoreEl.textContent='0 / 10';paddle=202;active=true;overlay.style.display='none';reward.hidden=true;incoming(performance.now())}
function finish(win){active=false;overlay.style.display='flex';heading.textContent=win?'YOU WON!':'GAME OVER';start.textContent=win?'PLAY AGAIN':'TRY AGAIN';if(win){reward.textContent='N41 55.105 W088 20.060';reward.hidden=false}else{reward.hidden=true;attempt++;attemptEl.textContent=attempt}}
function frame(t){const dt=Math.min((t-last)/1000,.05);last=t;if(active){if(up)paddle-=650*dt;if(down)paddle+=650*dt;paddle=Math.max(0,Math.min(404,paddle));const elapsed=t-beginTime;if(mode==='incoming'){const p=Math.min(1,elapsed/incomingMs);ballX=730+(69-730)*p;ballY=240+((38+pattern[score]*404)-240)*p;if(p===1){if(ballY>=paddle-9&&ballY<=paddle+85){score++;best=Math.max(best,score);scoreEl.textContent=score+' / 10';bestEl.textContent=best;if(score===10)finish(true);else{mode='returning';beginTime=t;returnY=ballY}}else finish(false)}}else if(mode==='returning'){const p=Math.min(1,elapsed/returningMs);ballX=69+(730-69)*p;ballY=returnY+(240-returnY)*p;if(p===1)incoming(t)}trail.push({x:ballX,y:ballY});if(trail.length>9)trail.shift()}
ctx.fillStyle='#090e1b';ctx.fillRect(0,0,800,480);ctx.strokeStyle='#26354e';ctx.setLineDash([10,14]);ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(400,0);ctx.lineTo(400,480);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#4cc9ff';ctx.shadowColor='#38bdf8';ctx.shadowBlur=16;ctx.fillRect(44,paddle,14,76);ctx.shadowBlur=0;ctx.fillStyle='#fb7185';ctx.fillRect(742,ballY-38,14,76);trail.forEach((p,i)=>{ctx.globalAlpha=(i+1)/trail.length*.3;ctx.fillStyle='#facc15';ctx.beginPath();ctx.arc(p.x,p.y,8,0,Math.PI*2);ctx.fill()});ctx.globalAlpha=1;ctx.shadowColor='#facc15';ctx.shadowBlur=20;ctx.fillStyle='#fff5a4';ctx.beginPath();ctx.arc(ballX,ballY,9,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle='#8c9bb4';ctx.font='bold 14px monospace';ctx.textAlign='center';ctx.fillText('YOU',50,25);ctx.fillText('CPU',750,25);requestAnimationFrame(frame)}
function move(e){const r=canvas.getBoundingClientRect();paddle=Math.max(0,Math.min(404,(e.clientY-r.top)/r.height*480-38))}canvas.addEventListener('pointermove',move);canvas.addEventListener('pointerdown',move);window.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();if(!e.repeat)begin()}if(e.key==='ArrowUp'){e.preventDefault();up=true}if(e.key==='ArrowDown'){e.preventDefault();down=true}});window.addEventListener('keyup',e=>{if(e.key==='ArrowUp')up=false;if(e.key==='ArrowDown')down=false});start.onclick=begin;document.getElementById('restart').onclick=begin;requestAnimationFrame(frame)
})();
</script></body></html>
